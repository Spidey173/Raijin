# ==========================================
# Database & Broker Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raijin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/app/uploads

# ==========================================
# LLM Multi-Provider Settings
# ==========================================
# Options: auto (default), groq, google, anthropic, openai
LLM_PROVIDER=groq

# 1. Groq (High-speed inference: Qwen, Llama, Mixtral)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 4. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Authentication & Security
# ==========================================
SECRET_KEY=raijin-production-secure-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY=
ENABLE_ANONYMOUS_DEV_MODE=false
